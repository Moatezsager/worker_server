# ─── Worker Server Runtime ───
PORT=3000
NODE_ENV=development

# ─── Supabase (Shared Single Source of Truth for Worker & Web) ───
# Database URL (works with or without VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is strongly recommended for Worker Server (server-side writes & config)
SUPABASE_SERVICE_ROLE_KEY=
# Fallback / Anon key
VITE_SUPABASE_ANON_KEY=

# ─── Admin & Cron Security ───
# Min 8-16 chars, used for worker admin access & watchdog controls
ADMIN_PASSWORD=
# Used for securing Web Server <-> Worker Server internal API (/internal/jobs/*)
WORKER_INTERNAL_SECRET=
# Used for securing cron webhook endpoints (/api/refresh-parallel, /api/refresh-official, /api/cleanup-db)
CRON_SECRET=
API_HMAC_SECRET=

# ─── AI / Gemini Integration ───
# Used for intelligent market analysis and NLP currency rate extraction
GEMINI_API_KEY=

# ─── Telegram Client & Bot (GramJS) ───
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_BOT_TOKEN=

# ─── Social Media Broadcast (Optional) ───
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ─── Web Push (VAPID) ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── App URL (for keep-alive pings) ───
APP_URL=

