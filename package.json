{
  "name": "lyd-index-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "20.18.0"
  },
  "scripts": {
    "worker": "tsx --expose-gc src/worker.ts",
    "dev": "tsx --expose-gc src/worker.ts",
    "build": "esbuild src/worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/worker.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx tests/cbl-service.test.ts && tsx tests/internal-api.test.ts && tsx tests/scheduler.test.ts",
    "start": "node dist/worker.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.45.0",
    "@supabase/supabase-js": "^2.99.1",
    "@types/compression": "^1.8.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "esbuild": "^0.28.1",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  }
}
